# Ishonch — настройки. Скопируйте в .env: `cp .env.example .env` и заполните.
# Значения ниже подходят для локальной разработки. Что поменять для сервера — в комментариях
# и в docs/launch.md (раздел 3). [обязательно] — без этого на сервере не работает.
# Секреты генерируйте так: `openssl rand -hex 32`. Файл .env в git не коммитить.
# Пустые строки с `#` в начале — необязательные настройки: раскомментируйте, если нужны.

# ─── Telegram ────────────────────────────────────────────────────────────────

# [обязательно] Токен бота от @BotFather (/newbot). Без него API на сервере не запустится.
BOT_TOKEN=123456:replace-me
# [обязательно] Адрес Mini App по HTTPS (домен за Caddy). Его открывает кнопка бота.
MINIAPP_URL=https://ishonch.example.uz
# Ссылка на Mini App из BotFather (/newapp), например https://t.me/ishonch_bot/app.
# Нужна для кнопок «Купить» в постах каналов и ссылок из уведомлений.
# Пусто: используется https://t.me/<бот>?startapp=...
MINIAPP_LINK=
# [обязательно] Общий секрет бота и API: бот действует от имени пользователей.
# Случайная строка от 32 символов (`openssl rand -hex 32`); с заглушкой API на сервере не запустится.
INTERNAL_API_TOKEN=change-me-long-random
# Обновления от Telegram. Пусто — long polling (удобно локально).
# На сервере: https://<домен>/tg-webhook (nginx передаёт боту) и секрет от 16 символов (`openssl rand -hex 16`).
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=

# ─── Роли и служебные группы ──────────────────────────────────────────────────

# [обязательно] Telegram id администраторов через запятую (узнать: @userinfobot). Админка, баны, споры, сводка.
ADMIN_TELEGRAM_IDS=
# Telegram id операторов доставки через запятую: меняют статусы заказов кнопками в боте.
OPERATOR_TELEGRAM_IDS=
# Группа «Доставка»: подтверждённые заказы с телефонами и адресами. Пусто — каждому оператору в личку.
# Добавьте бота в группу админом; id супергруппы начинается с -100.
OPERATOR_CHAT_ID=
# Группа «Модерация»: объявления на проверку, жалобы, сообщения о краже. Пусто — каждому админу в личку.
MODERATION_CHAT_ID=
# Час утренней сводки администраторам (по Ташкенту, 0–23). -1 или пусто — не присылать.
DIGEST_HOUR=9

# ─── AI (Claude) ─────────────────────────────────────────────────────────────

# [обязательно] Ключ с console.anthropic.com: черновики объявлений, модерация, помощник покупателя.
# Без ключа черновики, проверка объявлений и помощник отвечают «AI недоступен»; тогда поставьте AI_MODERATION=false.
ANTHROPIC_API_KEY=sk-ant-replace-me
# Экономичная модель: разбор фото и текста, описания, модерация.
AI_MODEL_FAST=claude-haiku-5-5
# Сильная модель: только помощник покупателя.
AI_MODEL_STRONG=claude-opus-5-5
# Потолок расходов на AI в месяц, USD. После него AI-функции недоступны до следующего месяца (с 80% — предупреждение в логе).
AI_MONTHLY_LIMIT_USD=50
# Часть месячного потолка, которую может тратить сильная модель (помощник), USD.
AI_STRONG_MONTHLY_LIMIT_USD=20
# AI-проверка объявления при публикации. false — только правила, дубли фото и контакты в тексте.
AI_MODERATION=true

# ─── Значения по умолчанию для настроек админки ───────────────────────────────
# Записываются в базу при первом запуске; дальше меняются в админке («Настройки»), а не здесь.

# Проверок чужого объявления (скриншот или текст с другого сайта) на пользователя в день.
CHECKS_PER_DAY=5
# Вопросов помощнику покупателя на пользователя в день (самый дорогой вызов AI).
ASSISTANT_PER_DAY=10
# Курс доллара в сумах: AI пересчитывает цены, указанные в долларах.
USD_RATE=12800

# ─── Голосовые объявления ────────────────────────────────────────────────────

# Распознавание речи: любой Whisper-совместимый API (POST {STT_URL}/audio/transcriptions), с узбекским.
# Пусто — голосовой ввод выключен, фото и текст работают.
STT_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# ─── Уведомления ─────────────────────────────────────────────────────────────

# true — необязательные уведомления (снижение цены, подписки, предложения) ждут с 22:00 до 8:00 по Ташкенту.
QUIET_HOURS=true

# Видео-паспорт обязателен для телефонов, планшетов и ноутбуков: без короткого видео по сценарию
# (включение, *#06#, аккумулятор, аккаунт, корпус) объявление не публикуется. AI смотрит кадры при загрузке
# (нужен ffmpeg в образе — он уже есть в Dockerfile). В продакшене включён по умолчанию; false — отключить.
VIDEO_REQUIRED=true

# ─── Оплата и доставка ───────────────────────────────────────────────────────

# Оплата через платформу. Всегда false: Ishonch только связывает покупателя и продавца,
# деньги через сервис не идут — наличные продавцу или курьеру.
COD_PLATFORM_ENABLED=false
# Курьеры: пока только manual — оператор вызывает курьера сам.
COURIER_PROVIDER=manual

# ─── Краденые IMEI ───────────────────────────────────────────────────────────

# Внешняя база краденых и потерянных IMEI. none — пока нет договора (своя база «Украли телефон» работает и так).
# http — запрос GET $IMEI_REGISTRY_URL?imei=... с Authorization: Bearer $IMEI_REGISTRY_TOKEN,
# ответ {"status":"clean"|"listed"}.
IMEI_REGISTRY=none
IMEI_REGISTRY_URL=
IMEI_REGISTRY_TOKEN=

# ─── Mini App: ссылки на юридические тексты ──────────────────────────────────
# Показываются на экране согласия и в профиле. Вшиваются в сборку: после изменения
# пересоберите — `docker compose up -d --build`.

# Публичная оферта.
VITE_OFFER_URL=
# Политика конфиденциальности.
VITE_PRIVACY_URL=
# Список запрещённых товаров.
VITE_PROHIBITED_URL=

# ─── Безопасность и мониторинг ───────────────────────────────────────────────

# [обязательно на сервере] Откуда Mini App обращается к API: https://<домен>. * — только для разработки.
CORS_ORIGIN=*
# Секрет подписи ссылок на фото. Пусто — выводится из INTERNAL_API_TOKEN (при его смене старые ссылки перестанут работать).
PHOTO_URL_SECRET=
# Токен для Prometheus: /metrics с заголовком Authorization: Bearer <токен>. Пусто — /metrics нет.
METRICS_TOKEN=
# Общие счётчики лимитов запросов, если запущено несколько копий API (redis://redis:6379).
# Пусто — счётчики в памяти; для одной копии этого достаточно.
REDIS_URL=
# Версия в ответе /health и в логах: git-коммит или тег релиза, например `APP_VERSION=$(git rev-parse --short HEAD)`.
# APP_VERSION=dev
# Сколько секунд действителен запуск Mini App (initData). По умолчанию 4 часа.
# INIT_DATA_MAX_AGE_SEC=14400
# За nginx брать IP клиента из X-Forwarded-For. false — если API смотрит в интернет напрямую.
# TRUST_PROXY=true
# Лимиты запросов на пользователя: on/off. По умолчанию включены (кроме тестов). Не выключайте на сервере.
# RATE_LIMITS=on

# ─── База данных ─────────────────────────────────────────────────────────────

# Адрес PostgreSQL для локального запуска. В docker compose подставляется сам из POSTGRES_PASSWORD.
DATABASE_URL=postgres://ishonch:ishonch@localhost:5432/ishonch
# [обязательно на сервере] Пароль базы (`openssl rand -hex 24`). С паролем по умолчанию API пишет UNSAFE CONFIG.
# Меняйте до первого запуска: у уже созданной базы пароль меняется вручную (ALTER USER).
# Пусто — docker compose берёт пароль разработки «ishonch» (как в DATABASE_URL выше).
POSTGRES_PASSWORD=

# ─── Хранилище фото ──────────────────────────────────────────────────────────

# s3 — MinIO (на сервере; docker compose задаёт сам), fs — папка STORAGE_DIR (разработка).
STORAGE_DRIVER=fs
STORAGE_DIR=./data/storage
# Адрес MinIO для локального запуска. В docker compose подставляется сам (http://minio:9000).
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=ishonch
# [обязательно на сервере] Пароль MinIO (`openssl rand -hex 24`). С паролем по умолчанию API пишет UNSAFE CONFIG.
MINIO_ROOT_PASSWORD=ishonch-secret
# Бакет для фото; создаётся при запуске (minio-init).
MINIO_BUCKET=ishonch-photos
# Закрепите проверенные теги образов: latest меняется при пересборке.
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest

# ─── Сервер ──────────────────────────────────────────────────────────────────

# Порт Mini App на 127.0.0.1 (за ним Caddy с HTTPS).
# MINIAPP_PORT=8080
# Бэкапы (deploy/backup.sh): папка и сколько дней хранить дампы.
# BACKUP_DIR=./backups
# KEEP_DAYS=14
