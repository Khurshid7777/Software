# --- Telegram ---
BOT_TOKEN=123456:replace-me
MINIAPP_URL=https://ishonch.example.uz
INTERNAL_API_TOKEN=change-me-long-random
# Comma-separated Telegram user ids that get the admin role
ADMIN_TELEGRAM_IDS=

# --- AI (Claude) ---
ANTHROPIC_API_KEY=sk-ant-replace-me
# Economical model: extraction, descriptions, moderation
AI_MODEL_FAST=claude-haiku-5-5
# Strong model: buyer assistant only (stage 3)
AI_MODEL_STRONG=claude-opus-5-5
AI_MONTHLY_LIMIT_USD=50

# --- Defaults for runtime settings (stored in the `settings` table on first start) ---
CHECKS_PER_DAY=5
# AI buyer assistant requests per user per day (the strong model is the most expensive call)
ASSISTANT_PER_DAY=10
USD_RATE=12800

# --- Seller cabinet (stage 2) ---
# Deep link base for the "Buy with delivery" button in channel posts (BotFather → Mini App short name).
# Empty: https://t.me/<bot>?startapp=listing_<id> is used.
MINIAPP_LINK=
# Speech-to-text for voice listings: any Whisper-compatible HTTP API (POST {STT_URL}/audio/transcriptions).
# Must handle Uzbek. Empty STT_URL disables voice input (photos/text still work).
STT_URL=
STT_API_KEY=
STT_MODEL=whisper-1
# Signs photo URLs; defaults to a value derived from INTERNAL_API_TOKEN.
PHOTO_URL_SECRET=
# Payment through the platform (cod_platform) stays off until a legal entity and courier contract exist.
COD_PLATFORM_ENABLED=false
# Optional notifications (price drops, followed sellers, offers to likers) wait from 22:00 to 08:00 Tashkent
QUIET_HOURS=true
# Shared rate-limit counters when running several API replicas (e.g. redis://redis:6379). Empty: in-memory.
REDIS_URL=
# Prometheus scrape token for /metrics (Authorization: Bearer ...). Empty: no /metrics endpoint.
METRICS_TOKEN=

# --- Delivery & trust (stage 4) ---
# Delivery operators (role "operator"): move order statuses with bot buttons.
OPERATOR_TELEGRAM_IDS=
# Telegram group for operators (confirmed orders with phones and addresses). Empty: DM each operator and admin.
# Add the bot to the group; ids of supergroups start with -100.
OPERATOR_CHAT_ID=
# Telegram group for moderators (pending listings, complaints). Empty: DM each admin.
MODERATION_CHAT_ID=
# Courier integration: only "manual" for now (operators book couriers themselves).
COURIER_PROVIDER=manual
# Lost/stolen IMEI registry. "none" until there is access; "http" calls an adapter:
# GET $IMEI_REGISTRY_URL?imei=... (Bearer $IMEI_REGISTRY_TOKEN) -> {"status":"clean"|"listed"}
IMEI_REGISTRY=none
IMEI_REGISTRY_URL=
IMEI_REGISTRY_TOKEN=
# AI pre-moderation at publication; "false" = duplicate and contact checks only.
AI_MODERATION=true

# --- Mini App build (consent screen links; texts from a lawyer) ---
VITE_OFFER_URL=
VITE_PRIVACY_URL=
VITE_PROHIBITED_URL=

# --- Admin (stage 5) ---
# Hour (Tashkent, 0-23) of the morning digest sent to ADMIN_TELEGRAM_IDS; -1 or empty turns it off.
DIGEST_HOUR=9

# Bot updates: empty = long polling. In production set the public URL (served by nginx → bot:8081)
# and a random secret (16+ characters) that Telegram sends with every update.
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=
AI_STRONG_MONTHLY_LIMIT_USD=20

# --- Infrastructure ---
# Pin tested image tags (":latest" changes on rebuild)
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
# Photo storage: s3 (MinIO, production) or fs (local folder STORAGE_DIR)
STORAGE_DRIVER=fs
STORAGE_DIR=./data/storage
MINIO_ENDPOINT=http://localhost:9000
DATABASE_URL=postgres://ishonch:ishonch@localhost:5432/ishonch
POSTGRES_PASSWORD=ishonch
MINIO_ROOT_USER=ishonch
MINIO_ROOT_PASSWORD=ishonch-secret
MINIO_BUCKET=ishonch-photos
CORS_ORIGIN=*
