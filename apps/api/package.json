{
  "name": "@ishonch/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit -p .",
    "typecheck": "tsc --noEmit -p .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "dev:seed-catalog": "tsx --env-file-if-exists=../../.env test/dev-seed-catalog.ts",
    "dev:mock": "tsx --env-file-if-exists=../../.env test/dev-mock-server.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-s3": "^3.1150.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@ishonch/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.6",
    "grammy": "^1.46.0",
    "ioredis": "^5.11.1",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
